    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES2018"],
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "target": "ES2018",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
