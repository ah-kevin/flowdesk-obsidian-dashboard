{
  "name": "flowdesk-dashboard-obsidian-plugin",
  "version": "2.0.18",
  "private": true,
  "description": "Local Obsidian plugin for rendering FlowDesk execution snapshots.",
  "main": "main.js",
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "build": "node scripts/build-reading-styles.mjs && node scripts/build-dashboard-ui.mjs && esbuild src/main.ts --bundle --external:obsidian --platform=node --target=es2018 --format=cjs --outfile=main.js",
    "build:ui": "node scripts/build-dashboard-ui.mjs",
    "dev": "esbuild src/main.ts --bundle --external:obsidian --platform=node --target=es2018 --format=cjs --outfile=main.js --watch",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node -c main.js",
    "release:verify": "node scripts/verify-release.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:release": "node --test tests/auto-release.test.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "^20.11.30",
    "esbuild": "^0.25.0",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "markdown-it": "15.0.2"
  }
}
